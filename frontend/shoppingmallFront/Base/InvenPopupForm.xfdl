        <Static id="sta_price" taborder="14" text="가격" left="281" top="149" width="100" height="32" style="background:navajowhite;border:1 solid #808080ff ;align:center middle;"/>
        <Static id="Static00" taborder="15" text="Static01" visible="false" left="34.24%" top="48" width="522" height="8" style="background:coral;opacity:30;"/>
        <Static id="sta_productName" taborder="16" text="상품명" onclick="div_product_Static01_onclick" left="281" top="118" width="100" height="32" style="background:navajowhite;border:1 solid #808080ff ;align:center middle;"/>
