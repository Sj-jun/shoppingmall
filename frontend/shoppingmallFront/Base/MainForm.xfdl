    <Style url="MyCss::newcss.css"/>
    <Script type="xscript5.0"><![CDATA[/*
화면명 : 메인 메뉴 이동 화면
작성자 : 정상준
작성일자 : 2026-04-10
*/
this.btn_emp_onclick = function(obj, e)
{
    this.getOwnerFrame().set_formurl("Base::EmployeeForm.xfdl");
};
this.btn_emp2_onclick = function(obj, e)
{
    this.Tab00.set_tabindex(0);
};


this.btn_wh_onclick = function(obj, e)
{
    this.Tab00.set_tabindex(1);
};

;
this.btn_inven_onclick = function(obj, e)
{
    this.Tab00.set_tabindex(2);
};

this.btn_category_onclick = function(obj:Button, e:nexacro.ClickEventInfo)
{
	 this.Tab00.set_tabindex(3);
};
this.btn_order_onclick = function(obj:Button, e:nexacro.ClickEventInfo)
{
	 this.Tab00.set_tabindex(4);
};

this.btn_orderByCat_onclick = function(obj:Button, e:nexacro.ClickEventInfo)
{
	this.Tab00.set_tabindex(5);
}

this.Tab00_canchange = function(obj:Tab, e:nexacro.TabIndexChangeEventInfo)
{
	trace("현재 탭 index = " + e.postindex);

    if (e.postindex == 0) // tabpage2
    {
        this.Tab00.tabpage1.Div00.set_url("Base::BK20260421_EmployeeForm.xfdl");
    }
}

]]></Script>
