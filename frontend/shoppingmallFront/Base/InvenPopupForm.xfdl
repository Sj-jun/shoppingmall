  <TypeDefinition url="..\default_typedef.xml"/>
  <Form id="InvenPopupForm" left="0" top="0" width="847" height="325" titletext="New Form" onload="InvenPopupForm_onload" onclose="InvenPopupForm__close">
    <Layouts>
      <Layout>
        <Div id="div_warehouse" taborder="10" left="119" top="87" width="708" height="32" style="border:1 solid black ;">
