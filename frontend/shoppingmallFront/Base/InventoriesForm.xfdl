              <Combo id="cbo_region" taborder="3" left="102" top="49" width="140" height="28" innerdataset="@ds_region" codecolumn="regionId" datacolumn="regionName" onitemchanged="div_inven.cbo_region_onitemchanged" displaynulltext="-전체-" style="align:center middle;"/>
