        <Button id="btn_inven" taborder="3" text=" 재고/상품 관리" left="241" top="75" width="142" height="40" onclick="btn_inven_onclick" style="image:URL('Images::box.png');imagealign:lefttext;bordertype:normal 0 0 ;font:10 맑은 고딕;gradation:linear 10,10 lightsteelblue 0,100 #ecece5ff;"/>
